    <TABLE>
     <ROW><CELL><TEXT><CHAR>구분</CHAR></TEXT></CELL><CELL><TEXT><CHAR>2025년</CHAR></TEXT></CELL><CELL><TEXT><CHAR>2026년</CHAR></TEXT></CELL></ROW>
     <ROW><CELL><TEXT><CHAR>예산</CHAR></TEXT></CELL><CELL><TEXT><CHAR>452</CHAR></TEXT></CELL><CELL><TEXT><CHAR>1,800</CHAR></TEXT></CELL></ROW>
     <ROW><CELL><TEXT><CHAR>인원</CHAR></TEXT></CELL><CELL><TEXT><CHAR>12</CHAR></TEXT></CELL><CELL><TEXT><CHAR>31</CHAR></TEXT></CELL></ROW>
