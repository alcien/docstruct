# ─────────────────────────────────────────────────────────────────────
#  .env 는 **선택 사항**입니다.
#
#  사내 공용 LLM 엔드포인트·모델은 코드에 기본값으로 들어 있어,
#  아무 설정 없이도 바로 동작합니다.
#  아래 항목은 기본값을 **덮고 싶을 때만** 지정하세요.
#
#  현재 적용 중인 값은 다음으로 확인합니다.
#      docstruct --check
#      python -c "from docstruct import defaults; print(defaults())"
# ─────────────────────────────────────────────────────────────────────

# ── LLM (표 평가·재추출·목차) ────────────────────────────────────────────
# DOCLING_TABLE_API_URL=http://218.145.29.207:11060/v1/chat/completions
# DOCLING_TABLE_API_MODEL=/model/RedHatAI_gemma-4-31B-it-FP8-block/
# DOCLING_TABLE_API_KEY=                # OpenAI 등 인증이 필요한 경우
# DOCLING_TABLE_API_TIMEOUT=120

# ── LLM 대비책 (기본 엔드포인트에 연결이 안 될 때) ──────────────────────
#  사내 서버가 내려가 있으면 자동으로 이쪽으로 전환합니다.
#  **키가 있어야 동작합니다.** 없으면 전환 없이 표 평가·재추출만 생략됩니다.
#  인증 실패(401)나 잘못된 응답은 전환 대상이 아닙니다 — 연결 불가일 때만입니다.
# OPENAI_API_KEY=sk-...                 # 이것만 넣으면 아래는 기본값으로 동작
# DOCLING_TABLE_API_FALLBACK_MODEL=gpt-5.6-luna
# DOCLING_TABLE_API_FALLBACK_URL=https://api.openai.com/v1/chat/completions
# DOCLING_TABLE_API_FALLBACK=off        # 대비책 자체를 끄기

# ── 그림 설명 VLM ──────────────────────────────────────────────────────
# DOCLING_PICTURE_API_URL=http://218.145.29.207:11060/v1/chat/completions
# DOCLING_PICTURE_API_MODEL=/model/RedHatAI_gemma-4-31B-it-FP8-block/
# DOCLING_PICTURE_API_PROMPT=Describe this image concisely and accurately in Korean.
# DOCLING_PICTURE_AREA_THRESHOLD=0.01   # 이보다 작은 그림은 LLM 호출 생략

# ── LLM 동시 호출 ───────────────────────────────────────────────────────
#  I/O 대기라 CPU 코어 수와 무관합니다. 429 가 잦으면 낮추세요.
# DOCLING_LLM_CONCURRENCY=4

# ── 연산 장치 ───────────────────────────────────────────────────────────
#  auto 면 알아서 판단합니다. cuda 를 지정했는데 쓸 수 없으면 CPU 로 내려갑니다.
# DOCLING_DEVICE=auto                   # auto | cpu | cuda | mps
# DOCLING_NUM_THREADS=0                 # 0 이면 기본값
# DOCLING_RAPIDOCR_RUNTIME=onnxruntime  # onnxruntime | torch | openvino | paddle
# DOCLING_THREADED_PIPELINE=false       # Docling 단계 병렬화

# ── PDF 파싱 ────────────────────────────────────────────────────────────
#  특정 페이지가 "'utf-8' codec can't decode byte ..." 로 실패하면 백엔드를 바꿔보세요.
# DOCLING_PDF_BACKEND=auto              # auto | pypdfium2 | dlparse
# DOCLING_FORCE_FULL_PAGE_OCR=false     # 텍스트 레이어 무시하고 전면 OCR
# DOCLING_GENERATE_PARSED_PAGES=false   # 페이지별 텍스트 출처 측정 (메모리↑)
# DOCLING_CODE_FORMULA_ENRICHMENT=false # 수식·코드 VLM (표 추출엔 불필요)

# ── OCR ────────────────────────────────────────────────────────────────
# DOCLING_OCR_BACKEND=rapidocr          # rapidocr | tesseract | easyocr | auto
#  언어 코드 규약이 엔진마다 다릅니다.
#    rapidocr : korean, english   /  easyocr : ko, en  /  tesseract : kor, eng
# DOCLING_OCR_LANG=korean, english
